# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ThaiApp
DB_USER=your_user
DB_PASSWORD=your_password

# API Security
API_KEY=your_secure_api_key_here

# Telegram & AI Config
BOT_TOKEN=1234567890:YOUR_TELEGRAM_BOT_TOKEN_HERE
KIMI_CODE_API_KEY=sk-kimi-YOUR_KEY_HERE
DEEPSEEK_API_KEY=sk-deepseek-YOUR_KEY_HERE

# Pinecone AI Search (disabled by default)
PINECONE_ENABLED=false
PINECONE_RERANK_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=public
PINECONE_MODEL=multilingual-e5-large
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
